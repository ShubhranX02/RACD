Eye Proxy

.lib "/Users/shubhransharma/.ciel/ciel/sky130/versions/bdc9412b3e468c102d01b7cf6337be06ec6e9c9a/sky130A/libs.tech/ngspice/sky130.lib.spice" tt
.option temp=27
.option scale=1u

Vdd vdd 0 1.8

Vinp vin_p 0 DC 0.9 PULSE(0.9 1.0 0 10p 10p 200p 10n)
Vinn vin_n 0 DC 0.9 PULSE(0.9 0.8 0 10p 10p 200p 10n)


XM1 voutn vin_p s1 0 sky130_fd_pr__nfet_01v8 w=20.0 l=0.15
XM2 voutp vin_n s2 0 sky130_fd_pr__nfet_01v8 w=20.0 l=0.15

Rs s1 s2 817.7469482421875
Cs s1 s2 3.0575190816672926e-12

Itail1 s1 0 DC 100.0u
Itail2 s2 0 DC 100.0u

RL1 vdd voutn 2799.228271484375
RL2 vdd voutp 2799.228271484375

* 1-Tap DFE (Fully Differential)
Bslice_p vslice_p 0 V = V(voutp,voutn) > 0 ? 0.1 : -0.1
Bslice_n vslice_n 0 V = V(voutp,voutn) < 0 ? 0.1 : -0.1
Tdelay_p vslice_p 0 vdelayed_p 0 Z0=50 TD=200p
Tdelay_n vslice_n 0 vdelayed_n 0 Z0=50 TD=200p
Rdfe1 vdelayed_p voutp 40357.71875
Rdfe2 vdelayed_n voutn 40357.71875

.control
tran 2p 2n
wrdata _temp_eye_t_data v(voutp,voutn)
.endc
.end
